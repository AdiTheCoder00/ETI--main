# Copy to .env.local. Everything is optional for `npm run dev`: without Supabase, leads
# go to .data/leads.json and /admin has no login; without Resend, emails print to the
# console. Production needs the Supabase and Resend values.

# Public URL, used for metadata and the inbox link in notification emails.
NEXT_PUBLIC_SITE_URL=https://etidronevisuals.com

# Supabase (Project settings > API). The service-role key is server-only; never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin. Create these users in Supabase Auth.
ADMIN_EMAILS=

# Resend. ENQUIRY_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="ETI Drone Visuals <enquiries@etidronevisuals.com>"
STUDIO_EMAIL=contact@etidronevisuals.com

# Random string for hashing visitor IPs (rate limiting). Generate with: openssl rand -hex 32
LEAD_IP_SALT=

# Optional: Cloudflare Turnstile. Leave both empty to rely on honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob, for stills and clips uploaded at /admin/work. Set automatically on Vercel once a Blob
# store is connected to the project; copy it here to upload while running locally against Supabase.
# Without it: plain local mode saves uploads to public/media/uploads; with Supabase, uploads are off.
# The CSP allows this store's host, read from the token, so set it before building.
BLOB_READ_WRITE_TOKEN=

# Optional: serve the hero clip from a CDN instead of /public/media.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=

# Reel clips for /work. They are gitignored (public/media/clips) so they work locally but are
# never committed; point this at the CDN base URL for production, with no trailing slash.
NEXT_PUBLIC_CLIPS_BASE_URL=
